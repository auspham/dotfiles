// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
    "line_width": 2,
    "active_line_width": 3
  },
  "ui_font_family": ".ZedMono",
  "git_panel": {
    "tree_view": true
  },
  "middle_click_paste": false,
  "show_edit_predictions": false,
  "proxy": "",
  "redact_private_values": false,
  "git": {
    "inline_blame": {
      "min_column": 3,
      "show_commit_summary": true
    }
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "eager"
  },
  "cli_default_open_behavior": "new_window",
  "tabs": {
    "file_icons": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "tab_bar": {
    "show": true
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": ["--compile-commands-dir=."]
      }
    },
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {"typeCheckingMode": "off"}
      }
    }
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "profiles": {

    },
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        },
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^sonic\\-elastictest\\-agent/src/"
            }
          ]
        }
      }
    },
    "default_profile": "write",
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gpt-5.6-sol"
    },
    "dock": "left",
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.1"
    },
    "model_parameters": []
  },
  "format_on_save": "off",
  "colorize_brackets": true,
  "icon_theme": "Material Icon Theme",
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "sticky_scroll": {
    "enabled": true
  },
  "project_panel": {
    "entry_spacing": "standard",
    "dock": "right",
    "auto_reveal_entries": true
  },
  "show_whitespaces": "trailing",
  "buffer_font_family": "Fira Code",
  "buffer_line_height": "standard",
  "session": {
    "trust_all_worktrees": true
  },
  "vim": {
      "toggle_relative_line_numbers": true,
      "use_system_clipboard": "never"
  },
  "vim_mode": true,
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Frappé",
    "dark": "Catbox",
  },
  "theme_overrides": {
    "Catbox": {
      "accents": ["#fb4934", "#fabd2f", "#b8bb26", "#8ec07c", "#83a598", "#d3869b"],
      "tab.active_background": "#1d2021",
      "tab.inactive_background": "#2a2827",
      "tab_bar.background": "#2a2827",
      "syntax": {
        "string": { "color": "#a9b665" },
        "keyword": { "color": "#ff6e5e" },
        "function.builtin": { "color": "#fe8019" },
        "constant": { "color": "#d3869b" },
        "comment": { "color": "#a89984", "font_style": "italic" },
        "comment.doc": { "color": "#c6b697", "font_style": "italic" }
      }
    }
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.pnpm-store",
    "**/.turbo"
  ],
  "auto_install_extensions": {
    "tsgo": true
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server"
      ]
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server"
      ]
    },
    "CSharp": {
      "enable_language_server": false
    },
    "Python": {
      "format_on_save": "off",
      "formatter": [
        { "language_server": { "name": "ruff"}}
      ]
    }
  },
  "inlay_hints": {
    "enabled": false,
  },
  "lsp_results_location": "picker"
}
