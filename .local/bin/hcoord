#!/usr/bin/env bash
# hcoord: how a coordinator agent launches, watches and stops its child agents in herdr.
# Each child gets its own tab and its own git worktree, so parallel work never clashes.
#   hcoord spawn <name> "<task>" [--model M] [--effort E] [--repo DIR] [--base BRANCH]   (model and effort: the Team panel's choice unless given)
#   hcoord ls [--json]          hcoord diff <name> [--stat]
#   hcoord review <name> approved|changes|pending|reviewing|yours [note]
#   hcoord handoff <name> [--summary TEXT]   (stdin: one "high|normal|skim<TAB>path<TAB>reason" per file; hands the committed work to the user)
#   hcoord kill <name> [--worktree] [--force]
#   hcoord adopt [--from <space-id>]   (take over the children recorded in a space's ledger, or report them orphaned)
# spawn, review, handoff and kill also append to $COORDINATOR_HOME/spaces/<space>/ledger.jsonl (default ~/.claude/coordinator), the record a new coordinator adopts from.
set -euo pipefail

die() { echo "hcoord: $*" >&2; exit 1; }
for tool in hc herdr-app jq git; do command -v "$tool" >/dev/null 2>&1 || die "$tool is not installed"; done
me="${HC_TERMINAL_ID:-}"
[ -n "$me" ] || die "run this from the coordinator's own herdr terminal"

. "$(dirname "${BASH_SOURCE[0]}")/hcoord-ledger.sh"

children() { hc ls --json --label role=child --label "coord=$me" | jq -r '.terminals[].address'; }
label_of() { hc get "$1" --json | jq -r --arg k "$2" '.labels[$k] // empty'; }

# What the user picked in the Team panel for this space (model or effort), empty for Claude's own default.
picked() {
  local space file="${HERDR_TEAM_SETTINGS:-$HOME/.config/herdr-team/coordinator.json}"
  space=$(hc get "$me" --json 2>/dev/null | jq -r '.labels["herdr.space"] // empty' 2>/dev/null || true)
  jq -r --arg s "$space" --arg k "$1" '.spaces[$s][$k] // empty' "$file" 2>/dev/null || true
}

# The terminal of the child with this task name.
child_of() {
  local t
  for t in $(children); do
    if [ "$(label_of "$t" task)" = "$1" ]; then echo "$t"; return 0; fi
  done
  die "no child named $1"
}

cmd_spawn() {
  local name="${1:-}" task="${2:-}" model="" effort="" repo="$PWD" base=""
  [[ $name =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "the name must be lowercase letters, digits and hyphens"
  [ -n "$task" ] || die "give the child a task"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in --model) model="$2" ;; --effort) effort="$2" ;; --repo) repo="$2" ;; --base) base="$2" ;; *) die "unknown option $1" ;; esac
    shift 2
  done
  [ -n "$model" ] || model=$(picked model)
  [ -n "$effort" ] || effort=$(picked effort)
  local root; root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || die "$repo is not in a git repository"
  base="${base:-$(git -C "$root" symbolic-ref --short HEAD 2>/dev/null || git -C "$root" rev-parse --short HEAD)}"
  if (child_of "$name") >/dev/null 2>&1; then die "a child named $name already exists"; fi

  local worktree="$root/.agent-worktrees/$name" exclude
  exclude="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  grep -qxF '.agent-worktrees/' "$exclude" 2>/dev/null || echo '.agent-worktrees/' >> "$exclude"
  git -C "$root" worktree add -q -b "agent/$name" "$worktree" "$base"

  local argv message launched terminal
  argv=$(jq -cn --arg me "$me" --arg model "$model" --arg effort "$effort" '["env", "HERDR_ROLE=child", "HERDR_COORD=\($me)", "claude"] + (if $model == "" then [] else ["--model", $model] end) + (if $effort == "" then [] else ["--effort", $effort] end)')
  local sid cname dir="${CLAUDE_SESSIONS_DIR:-$HOME/.claude/sessions}"
  sid=$(label_of "$me" claude.session)
  cname=$(jq -r --arg s "$sid" 'select(.sessionId == $s) | .name // empty' "$dir"/*.json 2>/dev/null | head -n 1 || true)
  message="$task"$'\n\n'"You work in your own git worktree on branch agent/$name, started from $base. Stay inside this folder. Commit your work on that branch when it is done (signed off, Conventional Commits). When you finish or get stuck, tell your coordinator with SendMessage. $([ -n "$cname" ] && echo "Your coordinator is $cname (terminal $me); report to it with SendMessage to $cname." || echo "Your coordinator is terminal $me.")"
  # Without --space the tab opens in whichever space is focused, which is not necessarily the coordinator's.
  local space; space=$(label_of "$me" herdr.space)
  [ -n "$space" ] || die "cannot tell which herdr space this terminal is in"
  launched=$(herdr-app do tab.new --name "$name" --space "$space" --folder "$worktree" --argv "$argv" --task "$message" --focus false)
  terminal=$(jq -r '.terminal' <<<"$launched")
  hc label "$terminal" role=child "coord=$me" "task=$name" "worktree=$worktree" "branch=agent/$name" "base=$base" review=pending >/dev/null
  ledger_add spawn "$name" "$(jq -cn --arg task "$task" --arg repo "$root" --arg worktree "$worktree" --arg branch "agent/$name" --arg base "$base" --arg model "$model" --arg effort "$effort" --arg terminal "$terminal" \
    '{task: $task, repo: $repo, worktree: $worktree, branch: $branch, base: $base, model: $model, effort: $effort, terminal: $terminal}')"
  jq -cn --arg name "$name" --arg terminal "$terminal" --arg worktree "$worktree" --arg branch "agent/$name" '{name: $name, terminal: $terminal, worktree: $worktree, branch: $branch}'
}

# Where the child forked from its base, so work merged into the base since then is not counted against it.
fork_point() { git -C "$1" merge-base HEAD "$2" 2>/dev/null || echo "$2"; }
# Everything the child has changed since it forked, committed or not.
shortstat() { git -C "$1" diff --shortstat "$(fork_point "$1" "$2")" 2>/dev/null | sed 's/^ *//'; }

cmd_ls() {
  local t info rows=()
  for t in $(children); do
    info=$(hc get "$t" --json)
    rows+=("$(jq -c --arg stat "$(shortstat "$(jq -r '.labels.worktree' <<<"$info")" "$(jq -r '.labels.base' <<<"$info")")" \
      '{name: .labels.task, terminal: .address, status: (.status.state // "unknown"), review: (.labels.review // "pending"), branch: .labels.branch, diff: $stat}' <<<"$info")")
  done
  local all; all=$(printf '%s\n' ${rows[@]+"${rows[@]}"} | jq -s 'map(select(. != null))')
  if [ "${1:-}" = --json ]; then echo "$all"; return; fi
  jq -r '.[] | "\(.name)\t\(.terminal)\t\(.status)\t\(.review)\t\(.diff)"' <<<"$all" | column -t -s $'\t'
}

cmd_diff() {
  local t worktree base; t=$(child_of "${1:?name}")
  worktree=$(label_of "$t" worktree); base=$(label_of "$t" base)
  git -C "$worktree" status --short
  git -C "$worktree" diff ${2:+--stat} "$(fork_point "$worktree" "$base")"
}

cmd_review() {
  local t; t=$(child_of "${1:?name}")
  case "${2:-}" in approved | changes | pending | reviewing | yours) ;; *) die "review is approved, changes, pending, reviewing or yours" ;; esac
  hc label "$t" "review=$2" "review_note=${3:0:200}" >/dev/null
  ledger_add review "$1" "$(jq -cn --arg verdict "$2" --arg note "${3:-}" '{verdict: $verdict, note: $note}')"
}

cmd_handoff() {
  local name="${1:?name}" summary="" t worktree base mb head dir out json; shift
  case "${1:-}" in --summary) summary="${2:?text}" ;; "") ;; *) die "unknown option $1" ;; esac
  t=$(child_of "$name"); worktree=$(label_of "$t" worktree); base=$(label_of "$t" base)
  [ -z "$(git -C "$worktree" status --porcelain)" ] || die "$name has uncommitted changes; the user reviews committed work"
  mb=$(git -C "$worktree" merge-base HEAD "$base") head=$(git -C "$worktree" rev-parse HEAD)
  json=$(jq -n --arg guide "$(cat)" --arg ns "$(git -C "$worktree" -c core.quotePath=false diff --name-status --no-renames "$mb" HEAD)" \
    --arg nu "$(git -C "$worktree" -c core.quotePath=false diff --numstat --no-renames "$mb" HEAD)" --arg name "$name" --arg branch "$(label_of "$t" branch)" \
    --arg base "$mb" --arg head "$head" --arg summary "$summary" '
    def rows($s): $s | split("\n") | map(select(. != "") | split("\t"));
    (rows($ns)) as $st | (rows($nu) | map({key: (.[2:] | join("\t")), value: "\(.[0]):\(.[1])"}) | from_entries) as $nm |
    (rows($guide) | to_entries | map(if (.value | length) == 3 and (.value[0] | IN("high", "normal", "skim")) and .value[1] != "" and .value[2] != "" then {key: .value[1], value: {level: .value[0], reason: .value[2][0:200]}} else error("bad guide line \(.key + 1): want <high|normal|skim><TAB><path><TAB><reason>") end) | from_entries) as $g |
    ($g | keys - ($st | map(.[1])) | if length > 0 then error("not changed since the base: \(join(", "))") else . end) as $_ |
    {name: $name, branch: $branch, base: $base, head: $head, at: (now | strftime("%Y-%m-%dT%H:%M:%SZ")), summary: $summary,
     files: ($st | map(.[1] as $p | {path: $p, level: ($g[$p].level // "normal"), reason: ($g[$p].reason // "not in the coordinator'"'"'s guide"), sig: "\(.[0][0:1]):\($nm[$p])"}))}' 2>&1) || die "${json#jq: error*: }"
  dir="$(dirname "$(ledger_file)")/reviews"; mkdir -p "$dir"; out="$(cd "$dir" && pwd)/$name.json"
  printf '%s\n' "$json" > "$out.tmp" && mv "$out.tmp" "$out" && hc label "$t" review=yours "guide=$out" >/dev/null
  ledger_add handoff "$name" "$(jq -cn --arg guide "$out" --arg head "$head" '{guide: $guide, head: $head}')"
}

cmd_kill() {
  local name="${1:?name}" remove=false force=false
  shift; for flag in "$@"; do case "$flag" in --worktree) remove=true ;; --force) force=true ;; *) die "unknown option $flag" ;; esac; done
  local t worktree tab; t=$(child_of "$name")
  worktree=$(label_of "$t" worktree); tab=$(label_of "$t" herdr.tab)
  # Check before stopping anything, so a refusal leaves the agent running.
  if $remove && ! $force && [ -n "$(git -C "$worktree" status --porcelain)" ]; then
    die "$name has uncommitted changes; commit them or use --force to discard them"
  fi
  hc kill "$t" >/dev/null 2>&1 || true
  [ -z "$tab" ] || herdr-app do tab.close --id "$tab" >/dev/null 2>&1 || true
  hc rm "$t" >/dev/null 2>&1 || true
  if $remove; then
    local root opts=(); root="$(dirname "$(dirname "$worktree")")"
    ! $force || opts+=(--force)
    git -C "$root" worktree remove ${opts[@]+"${opts[@]}"} "$worktree"
    echo "removed the worktree; branch agent/$name is kept"
  fi
  ledger_add kill "$name" "{\"worktree_removed\": $remove}"
}

cmd_adopt() {
  local from="" src own line name worktree repo branch base terminal coord space t detail stat sep=$'\x1f'
  case "${1:-}" in --from) from="${2:?space id}" ;; "") ;; *) die "unknown option $1" ;; esac
  src=$(ledger_file "$from"); own=$(ledger_file)
  while IFS= read -r line <&3; do
    IFS="$sep" read -r name worktree repo branch base terminal coord space < <(jq -r '[.name, .worktree, .repo, .branch, .base, .terminal, .coord, .space] | map(. // "") | join("\u001f")' <<<"$line")
    if [ "$src" != "$own" ] && [ -z "$(ledger_events "$own" | jq -c --arg n "$name" 'select(.name == $n)')" ]; then
      mkdir -p "$(dirname "$own")"; ledger_events "$src" | jq -c --arg n "$name" 'select(.name == $n)' >> "$own"
    fi
    t=$(hc ls --json --label "task=$name" --label "worktree=$worktree" </dev/null | jq -r '.terminals[0].address // empty')
    if [ -z "$t" ]; then
      if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $worktree"; then
        stat=$(shortstat "$worktree" "$base"); detail="branch $branch, ${stat:-no changes}"
      else detail="branch $branch, worktree missing"; fi
      echo "orphaned $name $worktree ($detail)"
      continue
    fi
    if [ "$(label_of "$t" coord)" != "$me" ]; then
      hc label "$t" "coord=$me" >/dev/null
      ledger_add adopt "$name" "$(jq -cn --arg terminal "$t" --arg from_coord "$coord" --arg from_space "$space" '{terminal: $terminal, from_coord: $from_coord, from_space: $from_space}')"
    fi
    echo "adopted $name $t"
  done 3< <(ledger_events "$src" | jq -sc 'reduce .[] as $e ({}; .[$e.name] = (if $e.event == "spawn" then $e else (.[$e.name] // {}) + $e end)) | .[] | select(.event != "kill" and .worktree != null)')
}

case "${1:-}" in
  spawn) shift; cmd_spawn "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  diff) shift; cmd_diff "$@" ;;
  review) shift; cmd_review "$@" ;;
  handoff) shift; cmd_handoff "$@" ;;
  kill) shift; cmd_kill "$@" ;;
  adopt) shift; cmd_adopt "$@" ;;
  *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
